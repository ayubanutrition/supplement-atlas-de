{
  "name": "supplement-atlas-de",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "validate": "node scripts/validate-data.mjs",
    "release-check": "node scripts/release-check.mjs",
    "review-pack": "node scripts/review-pack.mjs",
