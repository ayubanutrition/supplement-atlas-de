---
import Base from '../../layouts/Base.astro';
import CompareTable from '../../components/CompareTable.astro';
import PriceBars from '../../components/PriceBars.astro';
import { getDataset } from '../../lib/load.ts';
import { published } from '../../lib/schema.ts';
import { CATEGORIES, type Category } from '../../lib/categories.ts';
import { formatDate, publishedProducts, priceNote } from '../../lib/view.ts';

export function getStaticPaths() {
  const d = getDataset();
  return CATEGORIES.filter((c) => publishedProducts(d, c.substanceId).length > 0).map((cat) => ({ params: { slug: cat.slug }, props: { cat } }));
}
interface Props { cat: Category }
const { cat } = Astro.props;
const d = getDataset();
const views = publishedProducts(d, cat.substanceId);
const duels = published(d.duels).filter((x) => views.some((v) => v.product.id === x.a));
const dates = views.flatMap((v) => (v.latest ? [v.latest.obs.observedAt] : [])).sort();
const asOf = dates.length ? formatDate(dates[dates.length - 1]) : '–';
---
<Base
  title={`${cat.name} im Vergleich: Preis pro ${cat.basisLabel} ${cat.unit} und Etikettangaben`}
  description={`${views.length} Produkte (${cat.name}) im Vergleich: Preis pro ${cat.basisLabel} ${cat.unit}, Zutaten, Portionsgröße und Versand – mit Quellen und Abrufdatum.`}
>
  <p class="crumbs"><a href="/">Start</a> › <a href={`/wirkstoffe/${cat.slug}/`}>{cat.name}</a> › Vergleich</p>
  <h1>{cat.name} im Vergleich</h1>
  <p class="lede">Wir vergleichen erfasste Produkte nach dem, was sich belegen lässt: Preis pro {cat.basisLabel} {cat.unit}, Zusammensetzung laut Etikett und Versandbedingungen. Stand: {asOf}.</p>

  <div class="note">
    <strong>Kein Testsieger.</strong> Wir haben keine eigenen Laboranalysen und vergeben noch keine Noten – die Bewertungsrubrik ist in Arbeit. Bisher erfasst: {views.length} Produkte. Die Auswahl ist keine Marktübersicht.
  </div>

  <h2>Preis pro {cat.basisLabel} {cat.unit}</h2>
  <div class="sortbar" id="sortbar" role="group" aria-label="Sortierung der Balken" hidden>
    <span class="small muted">Sortierung:</span>
    <button type="button" data-sort="name" aria-pressed="true">Alphabetisch</button>
    <button type="button" data-sort="pay" aria-pressed="false">Preis ohne Code</button>
    <button type="button" data-sort="reg" aria-pressed="false">Streich-/Listenpreis</button>
    <span class="small muted" id="sort-status" aria-live="polite"></span>
  </div>
  <PriceBars
    caption="Ohne Rabattcode zahlbarer Preis am Erfassungstag, ohne Versand. Gleiche Skala für alle Balken."
    items={views.map((v) => ({
      label: v.product.name,
      href: `/produkte/${v.product.id}/`,
      cents: v.latest?.payablePerBasis ?? null,
      note: priceNote(v.latest),
      sortPay: v.latest?.payablePerBasis ?? null,
      sortReg: v.latest?.regularPerBasis ?? null,
    }))}
  />
  <PriceBars
    caption={`Zum Vergleich: regulärer bzw. vom Shop angegebener Streichpreis pro ${cat.basisLabel}.`}
    items={views.map((v) => ({ label: v.product.name, href: `/produkte/${v.product.id}/`, cents: v.latest?.regularPerBasis ?? null, sortPay: v.latest?.payablePerBasis ?? null, sortReg: v.latest?.regularPerBasis ?? null }))}
  />
  <p class="small muted">{cat.basisNote} Eigene Packung umrechnen: <a href={cat.calculatorPath}>Preisrechner</a>.</p>

  {views.some((v) => v.product.labelNotes.some((n) => n.startsWith('Vergleichbarkeit:'))) && (
    <>
      <h2>Wie vergleichbar sind die Produkte?</h2>
      <ul>
        {views.map((v) => v.product.labelNotes.filter((n) => n.startsWith('Vergleichbarkeit:')).map((n) => <li><strong>{v.product.name}:</strong> {n.replace('Vergleichbarkeit: ', '')}</li>))}
      </ul>
    </>
  )}

  <h2>Etikett und Konditionen</h2>
  <CompareTable views={views} unit={cat.unit} basis={cat.basisLabel} caption={`Angaben der Anbieter, erfasst am ${asOf}. Auf schmalen Bildschirmen seitlich wischen.`} />

  {duels.length > 0 && (
    <>
      <h2>Direktvergleiche</h2>
      <ul>{duels.map((x) => <li><a href={`/duell/${x.slug}/`}>{x.question}</a></li>)}</ul>
    </>
  )}

  <h2>Was dieser Vergleich nicht zeigt</h2>
  <ul>
    <li>Reinheit oder Schadstoffe: Dazu bräuchte es aktuelle Analysen je Charge. Prüfangaben der Anbieter geben wir wieder, prüfen sie aber nicht selbst.</li>
    <li>Löslichkeit, Geschmack oder Verträglichkeit: Dazu haben wir keine eigenen Erhebungen.</li>
    <li>Rabattcodes, App-Preise und Abo-Preise: Erfasst ist der Preis ohne Code.</li>
  </ul>
  <p>Wie wir Daten erheben und rechnen: <a href="/methodik/">Methodik</a>.</p>
</Base>

<script>
  // Progressive Verbesserung: Balken umsortieren. Standard bleibt alphabetisch (keine Rangfolge unterstellen).
  const bar = document.getElementById('sortbar');
  if (bar) {
    bar.hidden = false;
    const status = document.getElementById('sort-status')!;
    const labels: Record<string, string> = { name: 'alphabetisch', pay: 'nach Preis ohne Code, günstigster zuerst', reg: 'nach Streich-/Listenpreis, günstigster zuerst' };
    const figures = Array.from(document.querySelectorAll<HTMLElement>('figure.bars'));
    const apply = (mode: string) => {
      for (const fig of figures) {
        const rows = Array.from(fig.querySelectorAll<HTMLElement>('.bar-row'));
        rows.sort((a, b) => {
          if (mode === 'name') return a.dataset.name!.localeCompare(b.dataset.name!, 'de');
          const av = a.dataset[mode], bv = b.dataset[mode];
          // Fehlende Werte ans Ende
          if (!av && !bv) return 0;
          if (!av) return 1;
          if (!bv) return -1;
          return Number(av) - Number(bv) || a.dataset.name!.localeCompare(b.dataset.name!, 'de');
        });
        rows.forEach((r) => fig.appendChild(r));
      }
      bar.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.sort === mode)));
      status.textContent = 'Sortiert ' + labels[mode] + '.';
    };
    bar.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => apply(b.dataset.sort!)));
  }
</script>
